#glimpse(tracts_county)
#glimpse(bgs_county)
bgs_county$flag025 <- ifelse(bgs_county$pctrc.0.25 > 0, 1, 0)
bgs_county$flag05 <- ifelse(bgs_county$pctrc.0.5 > 0, 1, 0)
bgs_county$flag1 <- ifelse(bgs_county$pctrc.1 > 0, 1, 0)
tracts_county$flag025 <- ifelse(tracts_county$pctrc.0.25 > 0, 1, 0)
tracts_county$flag05 <- ifelse(tracts_county$pctrc.0.5 > 0, 1, 0)
tracts_county$flag1 <- ifelse(tracts_county$pctrc.1 > 0, 1, 0)
bgs_county.n <- st_drop_geometry(bgs_county)
tracts_county.n <- st_drop_geometry(tracts_county)
tracts_county_tbl <-  tbl_summary(
tracts_county.n,
include = c(pctBlack, pctWhite, pctAsian, pctHisp, pctPov, perCapInc, pctNoHSD, pHhdCst30, pctHhdOwn, pctHhdFFem, golfMinDst, prevAsthma, prevCHD, prevCOPD, prevDiabts, prevGnHlth, prevMtHlth),
by = flag025,
missing = "ifany" ) |>
add_overall() |>
modify_header(
label = "**Variable**",
stat_1 = "**No RCC** (n={n})",
stat_2 = "**RCC in 0.25 mi** (n={n})",
) |>
add_p(
# perform t-test for all variables
test = everything() ~ "t.test",
# assume equal variance in the t-test
test.args = all_tests("t.test") ~ list(var.equal = TRUE)
)
