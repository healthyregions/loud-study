tm_shape(rail.geo) + tm_dots("#008080", size = 0.5)
tmap_mode("plot")
house.3435 <- st_transform(house, 3435)
congressionalDist118.3435 <- st_transform(congressionalDist118, 3435)
senate.3435 <- st_transform(senate,3435)
county.3435 <- st_transform(county, 3435)
rail.3435 <- st_transform(rail.geo, 3435)
df <- st_join(rail.3435, house.3435, join = st_intersects)
head(df)
df <- st_join(df, congressionalDist118.3435, join = st_intersects)
head(df)
df <- st_join(df , senate.3435, join = st_intersects)
head(df)
df <- st_join(df , county.3435, join = st_intersects)
head(df)
df.csv <-  st_drop_geometry(df)
write.csv(df.csv,"railsites.csv")
